{
  "compilerOptions": {
    "module": "ESNext",
    "lib": [
      "es6",
      "ESNext.Disposable"
    ],
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "types": [],
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "types/**/*.ts",
    "types/**/*.d.ts"
  ]
}
